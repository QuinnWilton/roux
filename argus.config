%% argus's configuration for roux, read by bin/argus (the argus escript):
%% Erlang terms, one {Key, Value} per key (see Argus.Config).

%% Every analysis: a warm run takes under a second.
{analyses, [all]}.

%% The dev build compiles test/support (probes and Concuerror models),
%% which only tests run.
{ignore, [{files, ["test/support/**"]}]}.

%% roux decodes only what it wrote itself (the manifest, CRC-checked;
%% the blob store, owner-only) and beams' literal and debug chunks,
%% which hold funs and atoms :safe refuses: notes, not warnings.
{severity, [{unsafe_input, info}]}.
